+            / (Wq + QUICK_N0)
+        qsd = math.sqrt(qvar)
+        wt = [(1.0 - r) * w for r, (_, _, _, w) in zip(resp, rows)]
+        Wt = sum(wt)
+        mu = sum(x * (y - b) for x, (_, y, b, _) in zip(wt, rows)) / (Wt + CAL_N0)
+        mu_cat = {}
+        for c in cats:
+            sw = sum(x for x, (cc, _, _, _) in zip(wt, rows) if cc == c)
+            sr = sum(x * (y - b) for x, (cc, y, b, _) in zip(wt, rows) if cc == c)
