+    def runs_of(self, durations, t0=1000.0, prompt="fix the failing login test"):
+        t = t0
+        for i, d in enumerate(durations):
+            self.ev(t, "UserPromptSubmit", prompt=prompt, prompt_id="m%d" % i)
+            self.ev(t + d, "Stop")
+            t += d + 60
+        return t
+
+    def test_mixture_survival_forgets_a_mode_once_past_it(self):
+        mix = [(0.3, 20.0, 0.5), (0.7, 300.0, 0.6)]
+        S0 = E.mixture_survival(mix, 0.0)
+        self.assertAlmostEqual(S0(60.0), 0.3 * (1 - E._norm_cdf((math.log(60) - math.log(20)) / 0.5))
+                               + 0.7 * (1 - E._norm_cdf((math.log(60) - math.log(300)) / 0.6)), places=6)
+        self.assertLess(S0(60.0), 0.75)                      # about a third may be over within a minute
+        late = E.mixture_survival(mix, 120.0)                # two minutes in: the quick mode is ruled out
+        task = E.lognormal_survival(300.0, 0.6, 120.0)
+        for t in (30.0, 120.0, 400.0):
+            self.assertAlmostEqual(late(t), task(t), places=2)
+
+    def test_calibration_finds_the_quick_mode(self):
+        rng = __import__("random").Random(3)
+        durs = [rng.lognormvariate(math.log(20), 0.4) if i % 10 < 3 else rng.lognormvariate(math.log(400), 0.4)
+                for i in range(80)]
+        t = self.runs_of(durs)
+        self.ev(t, "UserPromptSubmit", prompt="fix the failing login test", prompt_id="now")
+        state = E.state_from_run(self.conn, self.run_row(), t + 1)
+        mu_cat, mu, sigma, n, quick = E.calibration(E.Pool.load(self.conn, state["as_of"]), state)
+        self.assertEqual(n, 80)
+        self.assertTrue(0.22 < quick["share"]["fix"] < 0.38, quick["share"])
+        self.assertTrue(12 < math.exp(quick["mu"]) < 35, math.exp(quick["mu"]))
+        self.assertLess(sigma, 0.7)                          # the task mode alone is tight
+        # early in a turn a one-minute promise is now priced honestly: ~30 % finish within it
+        early = E.prior_survival(dict(state, active_s=5.0), (mu_cat, mu, sigma, n, quick))
+        self.assertTrue(0.6 < early(60.0) < 0.8, early(60.0))
+
