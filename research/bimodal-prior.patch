+def _fit_two_modes(rows):
+    """rows: (category, log duration, log built-in median, weight). MAP-style EM with the built-in values
+    as pseudo-observations, so a history without quick answers keeps a small quick share and a history
+    without long work keeps a task mode near the built-in pace."""
+    q0 = math.log(QUICK_MED_S)
+    qmu, qsd, share_all, share = q0, QUICK_SIGMA, QUICK_SHARE, {}
+    cats = sorted({c for c, _, _, _ in rows})
+    mu, mu_cat, tsd = 0.0, {}, SIGMA
+    for _ in range(EM_ITERS):
+        resp = []
+        for c, y, b, w in rows:
+            pi = share.get(c, share_all)
+            pq = pi * _npdf(y, qmu, qsd)
+            pt = (1.0 - pi) * _npdf(y, b + mu_cat.get(c, mu), tsd)
+            resp.append(pq / (pq + pt) if pq + pt > 0 else 0.0)
+        W = sum(w for _, _, _, w in rows)
+        Wq = sum(r * w for r, (_, _, _, w) in zip(resp, rows))
+        share_all = (Wq + QUICK_N0 * QUICK_SHARE) / (W + QUICK_N0)
+        share = {}
+        for c in cats:
+            sw = sum(w for cc, _, _, w in rows if cc == c)
+            sq = sum(r * w for r, (cc, _, _, w) in zip(resp, rows) if cc == c)
