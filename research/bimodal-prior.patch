+def mixture_survival(parts, elapsed=0.0):
+    """P(T - e > t | T > e) for T drawn from a mixture of log-normals [(weight, median, sigma)]. Once
+    the elapsed time is well past a mode, that mode's weight fades out by itself."""
+    parts = [(w, math.log(max(m, 0.5)), s) for w, m, s in parts if w > 0]
+
+    def sf(x):
+        if x <= 0:
+            return 1.0
+        lx = math.log(x)
+        return sum(w * (1.0 - _norm_cdf((lx - mu) / s)) for w, mu, s in parts)
+
+    base = sf(elapsed) if elapsed > 0 else sum(w for w, _, _ in parts)
+    if base < 1e-6:
+        return lognormal_survival(max(elapsed, 1.0) * 0.6, parts[-1][2])
+    return Curve(lambda t: 1.0 if t <= 0 else min(1.0, max(0.0, sf(elapsed + t) / base)))
+
